#######################################################################
# Test for copying block of size 63;
#######################################################################
	.pos 0
main:	irmovq Stack, %rsp  	# Set up stack pointer

	# Set up arguments for copy function and then invoke it
	irmovq $63, %rdx		# src and dst have 63 elements
	irmovq dest, %rsi	# dst array
	irmovq src, %rdi	# src array
	call ncopy		 
	halt			# should halt with num nonzeros in %rax
StartFun:

#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header

xorq %rax,%rax		# count = 0;

Part8:
	iaddq $-8,%rdx	
	jl Part4

Loop8:	mrmovq (%rdi), %r8	# read val from src...
  mrmovq 8(%rdi), %r9
  mrmovq 16(%rdi), %r10
  mrmovq 24(%rdi), %r11
  mrmovq 32(%rdi), %r12
  mrmovq 40(%rdi), %r13
  mrmovq 48(%rdi), %r14
  mrmovq 56(%rdi), %rbp

  iaddq $64, %rdi		# src++
	rmmovq %r8, (%rsi)	# ...and store it to dst
  rmmovq %r9, 8(%rsi)
  rmmovq %r10, 16(%rsi)
  rmmovq %r11, 24(%rsi)
  rmmovq %r12, 32(%rsi)
  rmmovq %r13, 40(%rsi)
  rmmovq %r14, 48(%rsi)
  rmmovq %rbp, 56(%rsi)
  iaddq $64, %rsi		# dst++

	andq %r8, %r8		# val <= 0?
	jle Check82
	iaddq $1, %rax		# count++
Check82:
  andq %r9, %r9
  jle Check83
  iaddq $1, %rax
Check83:
  andq %r10, %r10
  jle Check84
  iaddq $1, %rax
Check84:
  andq %r11, %r11
  jle Check85
  iaddq $1, %rax
Check85:
  andq %r12, %r12
  jle Check86
  iaddq $1, %rax
Check86:
  andq %r13, %r13
  jle Check87
  iaddq $1, %rax
Check87:
  andq %r14, %r14
  jle Check88 
  iaddq $1, %rax
Check88:
  andq %rbp, %rbp
  jle Continue8
  iaddq $1, %rax
Continue8:		
	iaddq $-8, %rdx		
	jg Loop8


Part4:
	iaddq $4,%rdx	 # + 8 - 4
	jl Part2

Loop4:	mrmovq (%rdi), %r8	# read val from src...
  mrmovq 8(%rdi), %r9
  mrmovq 16(%rdi), %r10
  mrmovq 24(%rdi), %r11

  iaddq $32, %rdi		# src++
	rmmovq %r8, (%rsi)	# ...and store it to dst
  rmmovq %r9, 8(%rsi)
  rmmovq %r10, 16(%rsi)
  rmmovq %r11, 24(%rsi)
  iaddq $32, %rsi		# dst++

	andq %r8, %r8		# val <= 0?
	jle Check42
	iaddq $1, %rax		# count++
Check42:
  andq %r9, %r9
  jle Check43
  iaddq $1, %rax
Check43:
  andq %r10, %r10
  jle Check44
  iaddq $1, %rax
Check44:
  andq %r11, %r11
  jle Continue4
  iaddq $1, %rax
Continue4:		
	iaddq $-4, %rdx		# len--
	jg Loop4			# if so, goto Loop:

Part2:
  iaddq $2, %rdx #+ 4 - 2
  jl Part1 
Loop2:
  mrmovq (%rdi), %r10
  mrmovq 8(%rdi), %r11
  iaddq $16, %rdi
  rmmovq %r10, (%rsi)
  rmmovq %r11, 8(%rsi)
  iaddq $16, %rsi
  andq %r10, %r10
  jle Check22
  iaddq $1, %rax
Check22:
  andq %r11, %r11
  jle Continue2
  iaddq $1, %rax
Continue2:
  iaddq $-2, %rdx
  jg Loop2


Part1:
    iaddq $2, %rdx
    jle Done
Loop1:
    mrmovq (%rdi), %r10
    iaddq $8, %rdi
    rmmovq %r10, (%rsi)
    iaddq $8, %rsi
    andq %r10, %r10
    jle Continue1
    iaddq $1, %rax
Continue1:
  iaddq $-1, %rdx
  jg Loop1

##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
EndFun:

