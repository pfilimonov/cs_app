	.pos 0 
	irmovq stack, %rsp  	# Set up stack pointer  
	call main		# Execute main program
	halt			# Terminate program 

# Sample linked list
.align 8
list:
ele1:
.quad 0x00a
.quad ele2
ele2:
.quad 0x0b0
.quad ele3
ele3:
.quad 0xc00
.quad 0

sum_list:
   xorq %rax, %rax
    xorq %r8, %r8
loop:
    subq %r8, %rdi
    je finloop
    mrmovq (%rdi), %rbx
    addq %rbx, %rax
    mrmovq 8(%rdi), %rdi
    jmp loop
finloop:
  ret
  

main:
  irmovq list, %rdi
  call sum_list
  halt
  
# The stack starts here and grows to lower addresses
	.pos 0x200		
stack:	 

